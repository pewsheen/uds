{
  "name": "uds",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run tests/core tests/adapters",
    "test:golden": "vitest run tests/golden",
    "test:mutation": "stryker run",
    "build": "node build.mjs",
    "pack": "node scripts/pack-extension.mjs",
    "test:smoke": "playwright test",
    "test:live": "node tests/live/fs-remount-chromium.mjs",
    "test:live:nav": "node tests/live/validate-nav.mjs",
    "test:live:ccon-nav": "node tests/live/validate-ccon-nav.mjs",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:unit",
    "verify:full": "pnpm verify && pnpm test:golden && pnpm test:mutation && pnpm build && pnpm test:smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.4",
    "fast-check": "^3.23.2",
    "jszip": "^3.10.1",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
